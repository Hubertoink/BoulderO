# Für lokale Entwicklung einen eigenen, zufälligen Wert verwenden.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Google OAuth ist optional. Erst nach dem Anlegen einer OAuth-Client-ID setzen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nur für lokale Tests. In Staging und Produktion immer false setzen.
DEMO_MODE=true

# Optionaler temporärer Verwaltungszugang. Beide Werte setzen, um ihn zu aktivieren.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Öffentliche URL dieser einzelnen Umgebung, ohne abschließenden Schrägstrich.
# Produktion: https://bouldero.de | Staging: https://dev.bouldero.de
APP_ORIGIN=http://localhost:8090

# SMTP für Bestätigungs- und Passwort-Reset-E-Mails. Das Passwort nie committen.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BoulderO <info@bouldero.de>
# Für lokale Vorschauen ohne echten Versand: EMAIL_TRANSPORT=json
EMAIL_TRANSPORT=

# Web Push bleibt deaktiviert, bis ein einmalig erzeugtes VAPID-Schlüsselpaar gesetzt ist.
# Erzeugung: npm run push:keys
PUSH_NOTIFICATIONS_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@example.com

POSTGRES_DB=bouldero
POSTGRES_USER=bouldero
POSTGRES_PASSWORD=change-this-local-database-password
